
classdef extract_header_information
    properties (SetAccess = private)
        filePath (1,1) string
        para struct = struct()
        ind  struct = struct()
        Nheader (1,1) double = 0
    end
    methods

        %Check if a datepaht is given
        function obj = check_filePath(filePath)
            if nargin > 0       % nargin stays for number of inputs an is provided of Matlab
                obj.filePath = string(filePath);

                if ~isfile(obj.filePath)    % In case file is not found
                   error("The file '%s' was not found.", obj.filePath);     % Error message
                end
            end
        end


        function obj = parseHeade(obj)
            fid = fopen(obj.filePath, 'rt');    % Open file fore reading and treat file as text
            
            if fid == -1
                error('The file could not be opened');
            end
            cleaner = onCleanup(@() fclose(fid)); % registers cleanup starts when function is closed

            tline = fget1(fid);  % Get datas form the first line of the file
            do_read_para = false;   %
            lastHeaderLine = '';    % When we get no data form a line, the programm see this as the end of the file
            
            while ischar(tline)     % As long as we get a char this loop will go on

                obj.Nheader = obj.Nheader +1;   %Counter for the Number of lines we get
                
                % Ignore every line until the line frameIntervall and then
                % start getting parameter data
                if ~isempty(regexp(tline, 'frameIntervalI', 'once'))   
                    do_read_para = true;
                end

                % Stop hear because after this you get the flight data
                if ~isempty(regexp(tline, 'loopIteration', 'once')) 
                    lastHeaderLine = tline;   % Get the names of the different flight data
                    break;
                end

                if do_read_para
                    idx = regexp(tline, '",');   % Split the parameter name an data up
                    para_name  = tline(2:idx-1); % Get the name of the parameter
                    para_value = tline(idx+2:end);% Get the parameter value
                    if strcmp(para_value(1), '"')   % If no value is stored
                        % Set the parameter name and the data together
                        try % 'magPID' '"40,,"' because this parameter is a special case
                            eval(['obj.para.(para_name) = [', para_value(2:end-1), '];']);  
                        end
                    else
                        eval(['(obj.para.para_name) = [', para_value, '];']);
                    end
                end
            tline = fgetl(fid); % Go to next line
            end
            fclose(fid);    % Close File 

            idx = regexp(tline, ',');   % Get position of commas in the last scanned line
            
            ind_cntr = 1;       % Index counter
    
    % Handle first element, should be 'loopIteration'
    ind_name = tline(2:idx(1)-2); %#ok
    eval(['obj.ind.(ind_name) = [', num2str(ind_cntr), '];']);
    
    % Handle all elements between
    for i = 1:length(idx)
        ind_cntr = ind_cntr + 1;
        if i < length(idx)
            ind_name = tline(idx(i)+2:idx(i+1)-2);  % Get me the name of every data in loopIteration
        else
            ind_name = tline(idx(end)+2:end-1);     % For the last name
        end
        
        % Get Names of flight data
        if strcmp(ind_name(1:4), 'eRPM')            
            eval(['obj.ind.(ind_name(1:4))(str2double((ind_name(end-1))) + 1) = [', num2str(ind_cntr), '];']);
        elseif strcmp(ind_name(end), ']')
            eval(['obj.ind.(ind_name(1:end-3))(str2double((ind_name(end-1))) + 1) = [', num2str(ind_cntr), '];']);
        else
            eval(['obj.ind.(ind_name) = [', num2str(ind_cntr), '];']);
        end
    end
end


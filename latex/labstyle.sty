% labstyle.sty – minimal+modern lab style (v2.0)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{labstyle}[2025/12/16 v2.0 Lab template with consolidated formatting]

% -----------------------------------------------------------------------------
% Engine + fonts
% -----------------------------------------------------------------------------
\RequirePackage{iftex}
\ifPDFTeX
	\RequirePackage[T1]{fontenc}
	\RequirePackage[utf8]{inputenc}
	\RequirePackage{lmodern}
\else
	\RequirePackage{fontspec}
	\setmainfont{Latin Modern Roman}
	\setsansfont{Latin Modern Sans}
	\setmonofont{Latin Modern Mono}
\fi

% -----------------------------------------------------------------------------
% Core packages
% -----------------------------------------------------------------------------
\RequirePackage{microtype}
\RequirePackage{graphicx}
\RequirePackage[dvipsnames]{xcolor}

\RequirePackage{siunitx}
\sisetup{
	per-mode = symbol,
	range-units = single
}

% Additional SI units
\DeclareSIUnit{\rpm}{rpm}
\DeclareSIUnit{\newtonmeter}{\newton\metre}

\RequirePackage{amsmath,amssymb}
\RequirePackage{booktabs}
\RequirePackage{enumitem}
\setlist{itemsep=.1\baselineskip, topsep=.1\baselineskip, leftmargin=*}

\RequirePackage{hyperref}
\hypersetup{
	colorlinks=true,
	linkcolor=black,
	citecolor=ZHAWBlue,
	urlcolor=ZHAWBlue,
}
\urlstyle{same}
\RequirePackage[nameinlink,capitalise]{cleveref}
\RequirePackage{etoolbox} % for \ifdefempty

% Code listings and directory trees
\RequirePackage{listings}
\RequirePackage{float}
\RequirePackage{dirtree}

% Listings configuration
\lstset{
basicstyle=\ttfamily\small,
frame=none,
breaklines=true,
literate={│}{{\textbar}}1 {├}{{$\vdash$}}1 {└}{{$\llcorner$}}1 {─}{{-}}1
}

% -----------------------------------------------------------------------------
% KOMA-Script page layout and formatting
% -----------------------------------------------------------------------------
\KOMAoptions{
	parskip=half,       % halber Zeilenabstand zwischen Absätzen
	headings=small,     % kleinere Überschriften
	headinclude=true,   % Kopfzeile einbeziehen
	footinclude=true    % Fußzeile einbeziehen
}

% Page dimensions
\areaset{165mm}{275mm} % Breite und Höhe des Textbereichs

% Section spacing
\RedeclareSectionCommand[
	beforeskip=1.5em,
	afterskip=0.75em
]{section}

\RedeclareSectionCommand[
	beforeskip=1.25em,
	afterskip=0.1em
]{subsection}

\RedeclareSectionCommand[
	beforeskip=1em,
	afterskip=0.1em
]{subsubsection}

% Section font sizes
\setkomafont{section}{\Large\bfseries}
\setkomafont{subsection}{\large\bfseries}
\setkomafont{subsubsection}{\normalsize\bfseries}

% Table of contents depth
\setcounter{tocdepth}{2}

% Caption spacing
\setlength{\abovecaptionskip}{0pt}
\setlength{\belowcaptionskip}{0pt}

% -----------------------------------------------------------------------------
% Paths / colors
% -----------------------------------------------------------------------------
\graphicspath{{figures/}{Figures/}}
\definecolor{labColor}{RGB}{0,100,166}
\definecolor{ZHAWBlue}{HTML}{0061A2}

% -----------------------------------------------------------------------------
% Metadata (override in main .tex)
% -----------------------------------------------------------------------------
\newcommand{\labtitle}{}
\newcommand{\labsubtitle}{}
\newcommand{\labauthor}{}
\newcommand{\labdate}{\today}

% -----------------------------------------------------------------------------
% Title block
% -----------------------------------------------------------------------------
\makeatletter
\newcommand{\makelabtitle}{%
	\par\vspace*{1em}%
	{\LARGE\bfseries \labtitle\par}%
	\ifdefempty{\labsubtitle}{}{%
		{\large\color{labColor}\labsubtitle\par}%
	}%
	{\normalsize \labauthor\quad\textendash\quad \labdate\par}
	\vspace{1em}\par
}
\makeatother

% -----------------------------------------------------------------------------
% Aufgaben environment
% -----------------------------------------------------------------------------
\newenvironment{aufgaben}[1][Aufgaben]{%
	\par\smallskip
	\begingroup\color{labColor}%
	\noindent\textbf{#1}\par\smallskip
	\begin{enumerate}[leftmargin=*]
		}{%
	\end{enumerate}%
	\endgroup
	\par\smallskip
}

% -----------------------------------------------------------------------------
% Helpers
% -----------------------------------------------------------------------------
\makeatletter
\newcommand{\labfig}[3][]{%
	\filename@parse{#2}% sets \filename@base
	\begin{figure}[htbp]
		\centering
		\includegraphics[#1]{#2}%
		\caption{#3}\label{fig:\filename@base}%
	\end{figure}
}
\makeatother

% --- gentable: caption below the table (store #2, then use it at the end)
\makeatletter
\newcommand{\gentable@cap}{}% storage for caption text
\newenvironment{gentable}[2]{%
	\def\gentable@cap{#2}%
	\begin{table}[htbp]\centering
		\begin{tabular}{#1}\toprule
			}{%
			\bottomrule\end{tabular}%
		\caption{\gentable@cap}%
	\end{table}%
}
\makeatother

\newcommand{\dd}{\mathrm{d}}
\newcommand{\e}{\mathrm{e}}

% -----------------------------------------------------------------------------
% Page style: thin rules + header/footer text & logo
% -----------------------------------------------------------------------------
\RequirePackage{scrlayer-scrpage}
\clearpairofpagestyles
\pagestyle{scrheadings}
\setkomafont{pageheadfoot}{\normalfont}

\KOMAoptions{
	headsepline=.2pt:\textwidth,
	footsepline=false,
	headinclude=true,
	headheight=45pt
}

\setlength{\headheight}{45pt}
\recalctypearea

% -----------------------------------------------------------------------------
% User metadata for header/footer
% -----------------------------------------------------------------------------
\newcommand{\labheader}{Betaflight - Offline Controller Tuning}
\newcommand{\labfooter}{ZHAW/IMS}
\newcommand{\lablogo}{imslogo.pdf}

\makeatletter
\ihead{\raisebox{-24pt}{\small \labheader}}
\ohead{%
	\ifdefempty{\lablogo}{}{%
		\IfFileExists{\lablogo}{\includegraphics[height=40pt]{\lablogo}}{}%
	}%
}
\ifoot{\small \labfooter}
\ofoot{\pagemark}
\makeatother

% -----------------------------------------------------------------------------
% Answer boxes (vertically scaled)
% -----------------------------------------------------------------------------
\RequirePackage[most]{tcolorbox} % loads TikZ
\usetikzlibrary{calc}

\tcbset{
	labbox/.style={
			colframe=labColor,
			colback=white,
			boxrule=0.8pt,
			arc=2pt,
			left=6pt,right=6pt,top=4pt,bottom=4pt,
		}
}

% Scale factor: 1.2 × baseline
\newlength{\labrowskip}
\setlength{\labrowskip}{\dimexpr 7\baselineskip/5\relax}

% Fixed-height empty box
\newenvironment{answerbox}[1][3]{%
	\begin{tcolorbox}[
			labbox, enhanced,
			width=\linewidth,
			height=\dimexpr #1\labrowskip + 8pt\relax,
			valign=center
		]%
		}{\end{tcolorbox}}

% Ruled variant
\newenvironment{answerboxruled}[1][3]{%
	\begin{tcolorbox}[
			labbox, enhanced,
			width=\linewidth,
			height=\dimexpr #1\labrowskip + 8pt\relax,
			overlay={%
					\pgfmathtruncatemacro{\N}{#1-1}%
					\foreach \i in {1,...,\N} {%
							\pgfmathsetlengthmacro{\y}{(\i + 0.25) * \the\labrowskip}%
							\draw[opacity=0.25]
							($(interior.south west) + (0pt,\y)$) --
							($(interior.south east) + (0pt,\y)$);
						}%
				}
		]%
		}{\end{tcolorbox}}

% Auto-height: fill to end of page
\makeatletter
\newlength{\ab@h}
\newlength{\ab@tmp}
\newcount\ab@N
\newcommand*\ab@pad{8pt}

\newenvironment{answerboxfillpage}{%
	\par\begingroup
	\ifhmode\par\fi
	\setlength{\ab@h}{%
		\ifdim\pagegoal=\maxdimen \textheight\else \dimexpr\pagegoal-\pagetotal\relax\fi
	}%
	\addtolength{\ab@h}{-\baselineskip}%
	\setlength{\ab@tmp}{\dimexpr \ab@h - \ab@pad\relax}%
	\ifdim\ab@tmp<0pt \setlength{\ab@tmp}{0pt}\fi
	\ab@N=0\relax
	\loop\ifdim\ab@tmp>\labrowskip
	\addtolength{\ab@tmp}{-\labrowskip}%
	\advance\ab@N by 1\relax
	\repeat
	\ifdim\ab@tmp>.6\labrowskip \advance\ab@N by 1\relax\fi
	\ifnum\ab@N<3 \ab@N=3\fi
	\setlength{\ab@h}{\dimexpr \ab@N\labrowskip + \ab@pad\relax}%
	\begin{tcolorbox}[labbox, enhanced,
			width=\linewidth, height=\ab@h, valign=top]%
		}{%
	\end{tcolorbox}\endgroup
}
\makeatother

\endinput
